    },
    {
      "source": "/:path*/",
      "has": [{ "type": "host", "value": "auto-cleanse.co.uk" }],
      "destination": "https://www.auto-cleanse.co.uk/:path*",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "auto-cleanse.co.uk" }],
      "destination": "https://www.auto-cleanse.co.uk/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(webp|jpg|jpeg|png|gif|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
