# ─────────────────────────────────────────────────────────────────────────────
# AutoCleanse Booking System — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────


# ── Site URL ──────────────────────────────────────────────────────────────────
# Full URL of your site, used for Stripe redirect URLs.
# No trailing slash. Use http://localhost:5173 for local dev with vercel dev.
SITE_URL=https://auto-cleanse.co.uk


# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
# Use sk_test_... / pk_test_... for development, sk_live_... for production.

STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret — found in Stripe Dashboard → Webhooks → your endpoint
# For local testing: stripe listen --forward-to localhost:3000/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME


# ── Google Calendar ───────────────────────────────────────────────────────────
# Setup steps:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project (or select existing)
# 3. Enable "Google Calendar API"
# 4. Go to IAM & Admin → Service Accounts → Create Service Account
# 5. Create a JSON key for the service account → download it
# 6. Open your Google Calendar → Settings → Share with specific people
#    → Add the service account email with "Make changes to events" permission
# 7. Copy the calendar ID from Calendar Settings → Integrate calendar

# The email address of your service account (ends in @...iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The private key from the downloaded JSON (the full -----BEGIN RSA PRIVATE KEY----- block)
# Replace actual newlines with \n so it fits on one line, e.g.:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----\n"

# Your Google Calendar ID — usually your Google email address for the primary calendar,
# or a custom calendar ID like abc123@group.calendar.google.com
GOOGLE_CALENDAR_ID=your-calendar@gmail.com


# ── Google Maps (optional but recommended for mobile bookings) ────────────────
# Used for accurate, traffic-aware travel time calculation.
# Without this, a postcode area lookup table is used as fallback.
# Setup: https://console.cloud.google.com/ → APIs → Routes API → enable it
# Restrict the key to "Routes API" and server IP addresses only.
GOOGLE_MAPS_API_KEY=AIzaSy_REPLACE_ME


# ── Workshop location ─────────────────────────────────────────────────────────
# Used as the origin for travel time calculations on mobile bookings.
# Full street address and postcode.
WORKSHOP_ADDRESS=Your Workshop Address, Totnes, Devon
WORKSHOP_POSTCODE=TQ9 5JA


# ── AutoCleanse Dashboard (Supabase) ─────────────────────────────────────────
# Connects confirmed website bookings to the AutoCleanse business dashboard.
# Use the "service role" key (not the anon key) — it bypasses RLS.
AUTOCLEANSE_SUPABASE_URL=https://qvtvwdahdgfehiaakhux.supabase.co
AUTOCLEANSE_SUPABASE_SERVICE_KEY=REPLACE_ME


# ── Calendly API ──────────────────────────────────────────────────────────────
# Personal access token — needed to fetch event date/time after a booking.
# Create at: https://calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=REPLACE_ME


# ── Notifications (Make.com / existing webhook) ───────────────────────────────
# Your existing Make.com webhook URL for booking notifications.
# Leave blank to skip Make.com notifications.
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/uw0b9gab1m4qdj1zhs4m4mkkn9kt5fva
